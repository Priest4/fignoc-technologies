# Production environment for www.fignoc.co.zw on cPanel.
# server-setup.sh copies this to .env (chmod 600) and generates APP_KEY.
# .env is NOT in git and survives every deploy -- edit it on the server only.

APP_NAME="Fignoc Technologies"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.fignoc.co.zw

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel MySQL. Names are prefixed with the cPanel user, e.g. daxutaxh_fignoc.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daxutaxh_fignoc
DB_USERNAME=daxutaxh_fignoc
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless you need cookies shared across subdomains.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Contact-form mail. Create the mailbox in cPanel -> Email Accounts, then use
# the mail hostname cPanel shows you. Port 465 = SSL, 587 = TLS.
MAIL_MAILER=smtp
MAIL_HOST=mail.fignoc.co.zw
MAIL_PORT=465
MAIL_USERNAME=hello@fignoc.co.zw
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="hello@fignoc.co.zw"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
